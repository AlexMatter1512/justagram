+    private void configureDialogInsets(Window window, LinearLayout content) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            // FLAG_FULLSCREEN prevents the window from resizing for the keyboard.
+            if (fullscreen) {
+                View decor = window.getDecorView();
+                decor.setSystemUiVisibility(decor.getSystemUiVisibility() | View.SYSTEM_UI_FLAG_FULLSCREEN);
+            }
+            window.setSoftInputMode(LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+            return;
+        }
+
+        window.setDecorFitsSystemWindows(false);
+        window.setSoftInputMode(LayoutParams.SOFT_INPUT_ADJUST_NOTHING);
+        content.setOnApplyWindowInsetsListener(InAppBrowser::applyDialogInsets);
+        content.setWindowInsetsAnimationCallback(new WindowInsetsAnimation.Callback(
+            WindowInsetsAnimation.Callback.DISPATCH_MODE_CONTINUE_ON_SUBTREE
+        ) {
+            @Override
+            public WindowInsets onProgress(WindowInsets insets, List<WindowInsetsAnimation> runningAnimations) {
+                // The initial inset dispatch is for the target state, before Gboard moves.
+                // Resize the WebView as the keyboard actually enters or leaves the window.
+                return applyDialogInsets(content, insets);
+            }
+
+            @Override
+            public void onEnd(WindowInsetsAnimation animation) {
+                if ((animation.getTypeMask() & WindowInsets.Type.ime()) != 0) {
+                    content.requestApplyInsets();
+                }
+            }
+        });
+    }
+
+    @TargetApi(Build.VERSION_CODES.R)
+    private static WindowInsets applyDialogInsets(View view, WindowInsets insets) {
+        Insets padding = insets.getInsets(
+            WindowInsets.Type.systemBars() | WindowInsets.Type.displayCutout() | WindowInsets.Type.ime()
+        );
+        view.setPadding(padding.left, padding.top, padding.right, padding.bottom);
+        // The native layout already fits these insets. Pass only the remainder to the WebView.
+        return insets.inset(padding.left, padding.top, padding.right, padding.bottom);
+    }
