+    public void handleHardwareBack() {
+        if (!hardwareBack() || !canGoBack()) {
+            closeDialog();
+            return;
+        }
+        if (dmOnlyBack && isDirectUrl(inAppWebView.getUrl())) {
+            WebBackForwardList history = inAppWebView.copyBackForwardList();
+            int previous = history.getCurrentIndex() - 1;
+            if (previous < 0 || !isDirectUrl(history.getItemAtIndex(previous).getUrl())) {
+                closeDialog();
+                return;
+            }
+            // Traverse exactly the DM entry we checked.
+            inAppWebView.goBackOrForward(-1);
+            return;
+        }
+        goBack();
+    }
+
+    private static boolean isDirectUrl(String url) {
+        if (url == null) return false;
+        Uri uri = Uri.parse(url);
+        String host = uri.getHost();
+        String path = uri.getEncodedPath();
+        return "https".equals(uri.getScheme()) && host != null &&
+            (host.equals("instagram.com") || host.endsWith(".instagram.com")) &&
+            ("/direct".equals(path) || (path != null && path.startsWith("/direct/")));
+    }
